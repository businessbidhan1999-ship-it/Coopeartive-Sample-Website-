# Required only for administrator sign-in. Public pages work without this file.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Session length in hours: 1 to 168; default 8.
SESSION_EXPIRY_HOURS=8

# Bootstrap users only when data/admins.json does not exist.
# Generate a bcrypt hash with the command documented in README.md.
# Use single quotes around the JSON value in .env.local.
ADMIN_USERS='[]'

# Optional public origin for correct social image URLs after deployment.
# NEXT_PUBLIC_SITE_URL=https://your-demo-domain.example

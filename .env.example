# ─── Authentication ────────────────────────────────────────────────────────────
# Generate a new secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-random-64-char-hex-string

# Admin user accounts (JSON array of bcrypt-hashed accounts)
# To generate a hash: node -e "console.log(require('bcryptjs').hashSync('YourPassword', 12))"
ADMIN_USERS=[{"username":"admin","passwordHash":"<bcrypt-hash>","role":"admin"},{"username":"editor","passwordHash":"<bcrypt-hash>","role":"editor"}]

# Session cookie expiry in hours
SESSION_EXPIRY_HOURS=8

# ─── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://royalcooperative.com.np

# ─── Email (optional — for form submission notifications) ──────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@royalcooperative.com.np
# SMTP_TO=info@royalcooperative.com.np
